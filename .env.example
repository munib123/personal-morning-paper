# Copy to .env.local (git-ignored) and fill in. Names and defaults: docs/ARCHITECTURE.md §5 and §9.7.
# Next.js loads .env.local for the app; tsx scripts load it through scripts/lib/env.ts.

# ── Supabase (Settings → API) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_…: server and jobs only, never shipped to the browser
SUPABASE_SECRET_KEY=

# ── Gemini (AI Studio). Model ids and budgets are env, so they swap without code changes ──
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_MODEL_TTS=gemini-3.8-flash-tts
# Requests per day per model (llm_usage budget guard; RPD resets 00:00 PT = 12:00 PKT)
GEMINI_RPD_FAST=450
GEMINI_RPD_FALLBACK=450
GEMINI_RPD_SMART=18
# Requests per minute per model (request pacing)
GEMINI_RPM_FAST=12
GEMINI_RPM_FALLBACK=12
GEMINI_RPM_SMART=4
# Only used when EMBEDDINGS_PROVIDER=gemini
GEMINI_EMBED_MODEL=gemini-embedding-2

# ── Embeddings ──────────────────────────────────────────────────────────
# local = transformers.js gte-small (no Gemini quota) | gemini = gemini-embedding-2 at 384 dims
EMBEDDINGS_PROVIDER=local
# Model download cache shared by every worktree (PLAN §4: %USERPROFILE%\.cache\subah-models).
# Write the real path; .env files do not expand %USERPROFILE%. Empty = transformers.js default.
MODEL_CACHE_DIR=

# ── App ─────────────────────────────────────────────────────────────────
# Bearer token for /api/cron/*; Vercel cron sends it automatically when this is set in the project
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Demo ────────────────────────────────────────────────────────────────
DEMO_MODE=1
DEMO_FALLBACK=1
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# ── PDF ─────────────────────────────────────────────────────────────────
# local PDF rendering uses system Chrome (Playwright uses it too when set)
PUPPETEER_EXECUTABLE_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"

# ── Supabase CLI only (npx supabase link / db push); never read by the app ──
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
