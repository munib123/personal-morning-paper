%%{init: {"theme": "neutral", "flowchart": {"curve": "basis", "nodeSpacing": 26, "rankSpacing": 44, "htmlLabels": true}, "themeVariables": {"fontFamily": "Libre Franklin, Helvetica Neue, Arial, sans-serif", "fontSize": "14px", "primaryColor": "#fbf8f1", "primaryBorderColor": "#1b1813", "primaryTextColor": "#1b1813", "lineColor": "#1b1813", "clusterBkg": "#f5f0e6", "clusterBorder": "#665c4f", "edgeLabelBackground": "#f5f0e6"}}}%%
flowchart LR
  %% The Morrow: system architecture as built on main (docs/ARCHITECTURE.md section 4 and the code in src/).
  %% Solid edges are the daily data path. Dotted edges are the learning loop and the off-request-path work.

  subgraph SRC["Sources: 117 seeded (114 RSS feeds + 3 keyless APIs)"]
    FEEDS["RSS and Atom feeds<br/>Dawn, BBC, Guardian, Ars Technica, Nature, Cricinfo ..."]
    APIS["Keyless APIs<br/>Hacker News, Dev.to, arXiv"]
  end

  subgraph WORKER["Worker: npm run job:ingest (Node 24; local or a cron runner, never on Vercel)"]
    ING["Ingest<br/>fetch, charset decode, canonical URL,<br/>url_hash dedupe, 48 h window"]
    NLP["NLP, local and free<br/>gte-small 384-d embeddings, zero-shot topic labels,<br/>leader clustering (cos 0.90), importance"]
    ENR["Gemini enrichment, once per article<br/>10 articles per request: headline, 3 summary tiers,<br/>why it matters, key fact, recall MCQ"]
    LLM["callLLM<br/>llm_cache, llm_usage daily budget guard, RPM pacing,<br/>ladder SMART to FAST to FALLBACK to deterministic"]
    GUARD["Deterministic guardrails<br/>numbers in source, word bands, entities, grounded answers;<br/>fails twice: extractive summary"]
  end

  subgraph SB["Supabase"]
    PG[("Postgres + pgvector<br/>articles, clusters, topics, editions, edition_items,<br/>events, user_interests, interest_snapshots, streaks")]
    AUTH["Auth<br/>anonymous readers + the demo persona"]
    STORE["Storage<br/>papers bucket, signed URLs"]
  end

  subgraph APP["Vercel: Next.js 16 App Router"]
    ONB["/start onboarding<br/>hierarchical topics, in your words, routine"]
    BUILD["buildEdition() rank-v1, pure TypeScript<br/>Beta(α,β) per topic + profile EMA, MMR λ 0.7,<br/>2 Thompson explore slots, 1 serendipity, 1 big story"]
    READ["/today, /paper/date, /archive<br/>why-tags, skip promotes a reserve story,<br/>Morning Recall, streak, read original via /r"]
    PDF["/api/editions/date/pdf<br/>Puppeteer A4 newspaper with QR codes, stored;<br/>/paper/date/print as the fallback"]
    ME["/me learning page<br/>interest bars, movers, change summary,<br/>signal timeline, fast-forward 7 days"]
    SIG["/api/events and /r/id<br/>open, dwell, read_original, skip,<br/>more, less, save, recall_answer, qr_scan"]
    LEARN["applySignal()<br/>reward to α or β (parents 0.3, grandparents 0.1),<br/>pos and neg EMA, 14-day refold toward the prior"]
    CLOCK["requestNow()<br/>demo clock cookie subah_now (DEMO_MODE)"]
  end

  GEM["Gemini API, free tier"]
  CRON["Vercel cron 00:00 UTC<br/>/api/cron/editions"]

  FEEDS --> ING
  APIS --> ING
  ING -->|"raw articles"| NLP
  NLP -->|"embedded, labelled, clustered"| ENR
  ENR --> LLM
  LLM <-->|"batched JSON, maxRetries 0"| GEM
  LLM --> GUARD
  GUARD -->|"enriched or extractive: always rankable"| PG
  NLP -->|"vectors, labels, clusters"| PG
  ONB -->|"Beta priors (2,1) (3,1) (4,1) (1,3)"| PG
  PG -->|"candidate pool (36 h, cached 10 min) + user model"| BUILD
  BUILD -->|"20 stories + 8 reserve, receipt, interest snapshot"| PG
  BUILD --> READ
  READ --> PDF
  PDF <--> STORE
  READ -->|"reading signals"| SIG
  SIG --> LEARN
  LEARN -->|"updated α, β and profile vectors"| PG
  LEARN -.->|"tomorrow's paper re-ranks"| BUILD
  PG --> ME
  BUILD -.->|"editor's note, after the response"| LLM
  CLOCK -.-> BUILD
  CRON -.->|"daily batch"| BUILD
  AUTH --> READ

  classDef learn fill:#e7eef8,stroke:#1f4e80,color:#1b1813;
  classDef ext fill:#f5f0e6,stroke:#665c4f,stroke-dasharray:4 3,color:#1b1813;
  classDef store fill:#efe8da,stroke:#1b1813,color:#1b1813;
  class SIG,LEARN,ME,ONB learn;
  class GEM,CRON ext;
  class PG,STORE,AUTH store;
